# Copy to .env.development.local to make `npm run dev` come up already signed in.
#
# Optional. Without this file the dev server behaves exactly as before and you
# sign in by hand. With it, the app signs itself in on first load, so verifying
# a change in the running app never costs a password prompt — and an agent can
# drive the local app on its own, which it otherwise cannot do at all.
#
# Use the same dedicated test account as .env.e2e.local, never a real user:
# whatever gets clicked while signed in lands in that account's data.
#
# Why this file and not .env.local: `vercel env pull` rewrites .env.local and
# would drop these. Vite also loads .env.development.local in development mode
# only, so these values cannot reach a production build even by accident.
#
# See src/lib/dev/devAutoLogin.ts.

VITE_DEV_LOGIN_EMAIL=replace-with-the-test-account-email
VITE_DEV_LOGIN_PASSWORD=replace-with-the-test-account-password
